{
  "baseline": {
    "path": "/yakin/examples/settop.toml",
    "toml": {
      "daemon": {
        "active": "pad",
        "lizard": "off",
        "imu": false
      },
      "profile": {
        "browser": {
          "layout": "xbox",
          "deadzone": {
            "stick": 0.5
          },
          "buttons": {
            "a": "key:KEY_ENTER",
            "b": "key:KEY_BACKSPACE",
            "dpad_down": "key:KEY_DOWN",
            "dpad_left": "key:KEY_LEFT",
            "dpad_right": "key:KEY_RIGHT",
            "dpad_up": "key:KEY_UP",
            "steam": "key:KEY_HOMEPAGE"
          },
          "axes": {
            "lstick": "keys:KEY_UP,KEY_DOWN,KEY_LEFT,KEY_RIGHT"
          },
          "chord": [
            {
              "hold": "view",
              "dpad_down": "key:KEY_VOLUMEDOWN",
              "dpad_left": "key:KEY_MUTE",
              "dpad_up": "key:KEY_VOLUMEUP"
            }
          ]
        },
        "desktop": {
          "layout": "xbox",
          "mouse": {
            "speed": 1.0,
            "accel": 1.3,
            "release_guard": 3,
            "smoothing": 0.5
          },
          "scroll": {
            "speed": 1.0,
            "natural": true
          },
          "buttons": {
            "a": "key:KEY_ENTER",
            "b": "key:KEY_ESC",
            "dpad_down": "key:KEY_DOWN",
            "dpad_left": "key:KEY_LEFT",
            "dpad_right": "key:KEY_RIGHT",
            "dpad_up": "key:KEY_UP",
            "lb": "desktop:workspace-up",
            "lpad_click": "mouse:middle",
            "lt_full": "mouse:right",
            "menu": "desktop:spawn:fuzzel",
            "quick": "menu:toggle",
            "rb": "desktop:workspace-down",
            "rpad_click": "mouse:left",
            "rt_full": "mouse:left",
            "steam": "desktop:overview",
            "view": "niri:switch-preset-column-width",
            "x": "desktop:fullscreen",
            "y": "menu:toggle"
          },
          "axes": {
            "lpad": "scroll",
            "lstick": "flicks:desktop:focus-up,desktop:focus-down,desktop:focus-left,desktop:focus-right",
            "rpad": "cursor"
          },
          "chord": [
            {
              "hold": "view",
              "dpad_down": "key:KEY_VOLUMEDOWN",
              "dpad_left": "key:KEY_MUTE",
              "dpad_up": "key:KEY_VOLUMEUP"
            },
            {
              "hold": "steam",
              "a": "desktop:maximize",
              "b": "desktop:close-window",
              "dpad_down": "niri:move-window-to-workspace-down",
              "dpad_left": "desktop:move-left",
              "dpad_right": "desktop:move-right",
              "dpad_up": "niri:move-window-to-workspace-up",
              "menu": "keyboard:toggle",
              "x": "desktop:screenshot",
              "y": "profile:pad"
            }
          ]
        },
        "pad": {
          "layout": "xbox",
          "deadzone": {
            "stick": 0.1,
            "trigger": 0.05
          },
          "stick": {
            "touch": true
          },
          "trigger": {
            "grip": true
          },
          "buttons": {
            "quick": "menu:toggle",
            "steam": "key:KEY_HOMEPAGE"
          },
          "chord": [
            {
              "hold": "view",
              "dpad_down": "key:KEY_VOLUMEDOWN",
              "dpad_left": "key:KEY_MUTE",
              "dpad_up": "key:KEY_VOLUMEUP"
            },
            {
              "hold": "steam",
              "y": "profile:desktop"
            }
          ]
        },
        "switch": {
          "layout": "xbox",
          "deadzone": {
            "stick": 0.1,
            "trigger": 0.05
          },
          "stick": {
            "touch": true
          },
          "buttons": {
            "a": "pad:east",
            "b": "pad:south",
            "quick": "menu:toggle",
            "steam": "key:KEY_HOMEPAGE",
            "x": "pad:north",
            "y": "pad:west"
          },
          "chord": [
            {
              "hold": "view",
              "dpad_down": "key:KEY_VOLUMEDOWN",
              "dpad_left": "key:KEY_MUTE",
              "dpad_up": "key:KEY_VOLUMEUP"
            }
          ]
        }
      },
      "menu": {
        "items": [
          {
            "label": "Launcher",
            "icon": "apps",
            "target": "desktop:spawn:fuzzel"
          },
          {
            "label": "Keyboard",
            "icon": "keyboard",
            "target": "keyboard:toggle"
          },
          {
            "label": "Overview",
            "icon": "overview",
            "target": "desktop:overview"
          },
          {
            "label": "Fullscreen",
            "icon": "fullscreen",
            "target": "desktop:fullscreen"
          },
          {
            "label": "Maximize",
            "icon": "maximize",
            "target": "desktop:maximize"
          },
          {
            "label": "Close",
            "icon": "close",
            "target": "desktop:close-window"
          },
          {
            "label": "Volume up",
            "icon": "volume-up",
            "target": "key:KEY_VOLUMEUP"
          },
          {
            "label": "Volume down",
            "icon": "volume-down",
            "target": "key:KEY_VOLUMEDOWN"
          },
          {
            "label": "Mute",
            "icon": "mute",
            "target": "key:KEY_MUTE"
          },
          {
            "label": "Pad mode",
            "icon": "gamepad",
            "target": "profile:pad"
          },
          {
            "label": "Desktop mode",
            "icon": "mouse",
            "target": "profile:desktop"
          },
          {
            "label": "Screen off",
            "icon": "display-off",
            "target": "desktop:screen-off"
          }
        ],
        "columns": 4
      },
      "auto": {
        "enabled": true,
        "default": "desktop",
        "rule": [
          {
            "app_id": "^nx2navi$",
            "profile": "switch"
          },
          {
            "app_id": "^steam_app_",
            "profile": "pad"
          },
          {
            "app_id": "^gamescope$",
            "profile": "pad"
          },
          {
            "app_id": "^dolphin-emu$",
            "profile": "pad"
          },
          {
            "app_id": "^PCSX2$",
            "profile": "pad"
          },
          {
            "app_id": "^org\\.libretro\\.RetroArch$",
            "profile": "pad"
          }
        ],
        "ignore": [
          "^pavucontrol$"
        ]
      }
    }
  },
  "dropins": [
    {
      "path": "/yakin/examples/config.d/50-example.toml",
      "toml": {
        "profile": {
          "desktop": {
            "buttons": {
              "steam": {
                "press": "desktop:overview",
                "long": "lizard:hold",
                "long_ms": 300
              },
              "x": "mouse:middle"
            }
          },
          "media": {
            "buttons": {
              "a": "key:KEY_PLAYPAUSE",
              "lb": "key:KEY_PREVIOUSSONG",
              "rb": "key:KEY_NEXTSONG"
            }
          }
        }
      }
    }
  ],
